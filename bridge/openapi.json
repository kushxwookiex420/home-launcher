{
  "openapi": "3.1.0",
  "info": {
    "title": "Home Bridge",
    "description": "Controls a paired Android launcher (the Home app) and hands tasks to a coding agent. The phone polls every few seconds while the launcher is on screen. Actions: status, page, app, torch, clear, remote, url.",
    "version": "1.1.0"
  },
  "servers": [{ "url": "https://home-bridge-qn2hnd-preview.freebuff.site" }],
  "paths": {
    "/send": {
      "post": {
        "operationId": "sendToPhone",
        "summary": "Queue one action for the phone",
        "description": "action=status reads battery, network, storage, unread counts. page takes home|mail|ai|apps|money|ent|control. app takes a partial app name. torch takes on|off. clear wipes unread counters. remote takes 'key|device name'. url takes an https link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string", "description": "Pairing code shown on the phone." },
                  "action": { "type": "string", "enum": ["status", "page", "app", "torch", "clear", "remote", "url"] },
                  "arg": { "type": "string" }
                },
                "required": ["code", "action"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Queued" } }
      }
    },
    "/state": {
      "get": {
        "operationId": "phoneState",
        "summary": "What the phone last reported",
        "parameters": [{ "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Recent commands and their output" } }
      }
    },
    "/note": {
      "post": {
        "operationId": "handTaskToAgent",
        "summary": "Leave a task for the Freebuff coding agent to pick up",
        "description": "Use this for anything that needs code changes, research or a new app build. Write one clear task per note. The agent reads unacknowledged notes at the start of its next turn.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "text": { "type": "string", "description": "The task, in plain language." },
                  "source": { "type": "string", "description": "Who wrote it, e.g. chatgpt." }
                },
                "required": ["code", "text"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Stored" } }
      }
    },
    "/reply": {
      "post": {
        "operationId": "replyToChat",
        "summary": "Agent writes a result back for you to read",
        "description": "Only the coding agent uses this. Read it back with /replies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "code": { "type": "string" }, "text": { "type": "string" } },
                "required": ["code", "text"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Stored" } }
      }
    },
    "/replies": {
      "get": {
        "operationId": "readAgentReplies",
        "summary": "Results the agent wrote for you",
        "description": "Call this after handing a task off, or when the user asks whether the build is done.",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "since", "in": "query", "required": false, "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "Replies newest last" } }
      }
    },
    "/files": {
      "post": {
        "operationId": "uploadSharedFile",
        "summary": "Put a file in the shared folder",
        "description": "Text or base64 up to 200k characters. Overwrites a file with the same name.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "name": { "type": "string" },
                  "content": { "type": "string" },
                  "encoding": { "type": "string", "enum": ["text", "base64"] },
                  "mime": { "type": "string" }
                },
                "required": ["code", "name", "content"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Stored" } }
      },
      "get": {
        "operationId": "listSharedFiles",
        "summary": "What is in the shared folder",
        "parameters": [{ "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Names, sizes and dates" } }
      }
    },
    "/file": {
      "get": {
        "operationId": "readSharedFile",
        "summary": "Read one file from the shared folder",
        "parameters": [
          { "name": "code", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The file's content and encoding" } }
      }
    },
    "/notes": {
      "get": {
        "operationId": "pendingTasks",
        "summary": "Tasks waiting for the agent",
        "parameters": [{ "name": "code", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Unacknowledged notes" } }
      }
    }
  }
}
