<?xml version="1.0" encoding="utf-8"?>
<!-- Neural core: white hot centre into cyan into the void. Braded on the launcher's reactor ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerX="0.35"
        android:centerY="0.3"
        android:endColor="#0A2A3A"
        android:gradientRadius="12dp"
        android:startColor="#DFFFFC"
        android:centerColor="#4FE3E0"
        android:type="radial" />
    <stroke
        android:width="1dp"
        android:color="#804FE3E0" />
</shape>
