<?xml version="1.0" encoding="utf-8"?>
<!-- Milky Way glass: deep black with a cyan nebula at the top left and a violet one bottom right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#F00A1220"
                android:endColor="#F20B0F1C"
                android:startColor="#F0142030"
                android:type="linear" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="#4D4FE3E0" />
        </shape>
    </item>
    <item android:gravity="top|start">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="120dp"
                android:startColor="#3D4FE3E0"
                android:type="radial"
                android:centerX="0.1"
                android:centerY="0.0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:gravity="bottom|end">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="110dp"
                android:startColor="#33A97BFF"
                android:type="radial"
                android:centerX="0.9"
                android:centerY="1.0" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
