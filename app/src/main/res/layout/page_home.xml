<?xml version="1.0" encoding="utf-8"?>
<!-- Home as a cockpit: time panel, reactor ring with comms gauges, system gauges, command line, grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <!-- REACTOR + COMMS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/bg_hud_panel">

            <com.jarvis.launcher.PulseRingView
                android:id="@+id/pulseRing"
                android:layout_width="158dp"
                android:layout_height="158dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/commsPanel"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hud_panel"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                style="@style/MicroHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.34"
                android:text="@string/hud_comms"
                android:textColor="@color/text_dim"
                android:textSize="7sp" />

            <LinearLayout
                android:id="@+id/commsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/notifHint"
                style="@style/MicroHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/notif_hint"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/homeBriefing"
        style="@style/MicroHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="" />

    <!-- HABITAT: the control center. Collapsed it is one row; it polls only while open. -->
    <com.jarvis.launcher.HabitatDashboardView
        android:id="@+id/habitatPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- command line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/homePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:text="&gt;"
            android:textColor="@color/cyan"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/homeCommand"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="@string/home_command_hint"
            android:imeOptions="actionGo"
            android:inputType="textVisiblePassword"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/homeRun"
            style="@style/MicroHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/home_run"
            android:textColor="@color/cyan" />
    </LinearLayout>


    <!-- Live search results; only used when the admin phrase has put Home in search mode. -->
    <LinearLayout
        android:id="@+id/commandResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_hud_panel"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hud_panel"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="6dp" />
</LinearLayout>
