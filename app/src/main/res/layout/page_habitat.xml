<?xml version="1.0" encoding="utf-8"?>
<!-- Habitat control center: collapsible so the cockpit below stays visible until you ask for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_habitat_glass"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- HEADER: neural core dot, title, connection chip, chevron -->
    <LinearLayout
        android:id="@+id/habitatHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/habitatCore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_habitat_core" />

        <TextView
            android:id="@+id/habitatTitle"
            style="@style/PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:letterSpacing="0.2"
            android:text="@string/habitat_title"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/habitatChip"
            style="@style/MicroHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_habitat_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/habitat_offline_chip"
            android:textColor="@color/text_dim"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/habitatToggle"
            style="@style/MicroHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:text="@string/habitat_open"
            android:textColor="@color/cyan"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habitatBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/habitatSync"
            style="@style/MicroHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/habitat_not_synced"
            android:textColor="@color/text_dim" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/habitatTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/habitatContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/habitatActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/habitatError"
            style="@style/MicroHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFB4C4"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/habitatLinkRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/habitatCode"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_pill"
                android:fontFamily="monospace"
                android:hint="@string/habitat_code_hint"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/habitatLink"
                style="@style/PillLabel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/habitat_link"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habitatFoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habitatRefresh"
                style="@style/MicroHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/habitat_refresh"
                android:textColor="@color/cyan" />

            <TextView
                android:id="@+id/habitatUnlink"
                style="@style/MicroHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/habitat_unlink"
                android:textColor="@color/text_dim" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
